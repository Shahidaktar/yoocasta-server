// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}



// ================= ENUMS =================

enum UserRole {
  TALENT
  RECRUITER
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum JobStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ApplicationStatus {
  APPLIED
  UNDER_REVIEW
  SHORTLISTED
  SELECTED
  REJECTED
}

enum MediaType {
  IMAGE
  VIDEO
  VIDEO_LINK
  ACTING_VIDEO
  CASTING_VIDEO
  AUDIO
}

enum ContractStatus {
  ACTIVE
  EXPIRING_SOON
  EXPIRED
  RENEWED
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

// ================= CORE USER =================

model User {
  id                String   @id @default(uuid())
  email             String   @unique
  username          String   @unique
  password          String
  phone             String?
  whatsappNo        String?
  role              UserRole
  status            UserStatus @default(ACTIVE)
  isEmailVerified   Boolean  @default(false)
  isVerified        Boolean  @default(false) // admin-verified talent badge
  profileCompleted  Boolean  @default(false)
  image             String?
  website           String?

  firstName         String?
  middleName        String?
  lastName         String?

  nationalityId     String?
  nationality       Nationality? @relation(fields: [nationalityId], references: [id])
  cityId            String?
  city              City? @relation(fields: [cityId], references: [id])

  views             Int @default(0)

  // Auth
  otp               String?
  otpCreatedAt      DateTime?
  resetPassKey      String?
  resetPassKeyCreatedAt DateTime?

  // Relations
  talentProfile     TalentProfile?
  companyProfile    CompanyProfile?
  applications      Application[]
  castBags          CastBag[]
  favourites        CompanyFavourite[]
  googleOauth       GoogleOAuth?
  subscription      UserSubscription?
  paymentTransactions PaymentTransaction[]

  emailVerifyToken          String?
  emailVerifyTokenCreatedAt DateTime?
  
  castBagTalentOf       CastBagTalent[] @relation("CastBagTalentOf")
  castBagFeedbackOf     CastBagFeedback[] @relation("CastBagFeedbackOf")
  contractUsageTalentOf ContractUsageTalent[] @relation("ContractUsageTalentOf")
  invitationsSent       Invitation[] @relation("InvitationRecruiter")
  invitationsReceived   Invitation[] @relation("InvitationTalent")

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("users")
}

model GoogleOAuth {
  id        String @id @default(uuid())
  userId    String @unique
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  googleId  String
  createdAt DateTime @default(now())

  @@map("google_oauth")
}

model Admin {
  id          String   @id @default(uuid())
  email       String   @unique
  password    String
  name        String?
  role        String   @default("SUPER_ADMIN") // SUPER_ADMIN | SUB_ADMIN
  permissions String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("admins")
}

// ================= TALENT PROFILE =================

model TalentProfile {
  id              String  @id @default(uuid())
  userId          String  @unique
  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  description     String?
  gender          String?
  dob             DateTime?
  age             Int?

  // Physical attributes
  hairColor       String?
  hairType        String?
  hairLength      String?
  eyeColor        String?
  height          String?
  weight          String?
  chest           String?
  waist           String?
  shoeSize        String?
  bodyStructure   String?
  tattoo          String?
  tattooComment   String?

  ethnicityId     String?
  ethnicity       Ethnicity? @relation(fields: [ethnicityId], references: [id])

  address         String?
  cityId          String?
  city            City? @relation(fields: [cityId], references: [id])
  experience      Int?

  bioDescription  String?
  skillDescription String?

  // Social
  facebook        String?
  twitter         String?
  linkedin        String?
  googleProfile   String?

  // Visibility-controlled fields
  whatsappNo      String?
  contactNumber   String?  // visible only to "Our Company" internal accounts
  contactEmail    String?  // visible only to "Our Company" internal accounts

  castingVideo    String?
  views           Int @default(0)

  // Relations
  categories      TalentCategory[]
  languages       TalentLanguage[]
  dialects        TalentDialect[]
  attributes      ProfileAttribute[]   // dynamic category-specific fields
  media           PortfolioMedia[]
  careerHistory   CareerHistory[]
  courses         TalentCourse[]
  likes           ProfileLike[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("talent_profiles")
}

// Dynamic category-specific attributes (replaces 20+ fixed columns)
model ProfileAttribute {
  id              String  @id @default(uuid())
  talentProfileId String
  talentProfile   TalentProfile @relation(fields: [talentProfileId], references: [id], onDelete: Cascade)

  categoryId      String
  category        Category @relation(fields: [categoryId], references: [id])

  key             String   // e.g., "style_of_dance", "individual_or_band", "camera_worked_on"
  value           String

  @@index([talentProfileId, categoryId])
  @@map("profile_attributes")
}

model PortfolioMedia {
  id              String  @id @default(uuid())
  talentProfileId String
  talentProfile   TalentProfile @relation(fields: [talentProfileId], references: [id], onDelete: Cascade)

  type            MediaType
  url             String?      // R2 URL for uploaded files
  videoLink       String?      // YouTube/Vimeo link
  title           String?      // Title for videos and audio
  caption         String?
  order           Int @default(0)
  folder          String?      // which R2 folder

  createdAt       DateTime @default(now())

  @@map("portfolio_media")
}

model CareerHistory {
  id              String  @id @default(uuid())
  talentProfileId String
  talentProfile   TalentProfile @relation(fields: [talentProfileId], references: [id], onDelete: Cascade)

  title           String
  description     String?
  startDate       DateTime?
  endDate         DateTime?

  @@map("career_history")
}

model TalentCourse {
  id              String  @id @default(uuid())
  talentProfileId String
  talentProfile   TalentProfile @relation(fields: [talentProfileId], references: [id], onDelete: Cascade)
  title           String
  institution     String?
  year            Int?

  @@map("talent_courses")
}

model ProfileLike {
  id              String @id @default(uuid())
  talentProfileId String
  talentProfile   TalentProfile @relation(fields: [talentProfileId], references: [id], onDelete: Cascade)
  likedByUserId   String

  createdAt       DateTime @default(now())

  @@unique([talentProfileId, likedByUserId])
  @@map("profile_likes")
}

// ================= COMPANY PROFILE =================

model CompanyProfile {
  id              String  @id @default(uuid())
  userId          String  @unique
  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  companyName     String
  contactPerson   String?
  description     String?       // ADDED
  logo            String?       // ADDED (for future uploads)
  website         String?       // ADDED
  companyType     String?       // ADDED

  isInternalCompany Boolean @default(false) 

  tradeLicense        String?  // ADDED
  tradeLicenseFile    String?  // ADDED (for future uploads)

  jobs            Job[]
  favourites      CompanyFavourite[]
  contractUsages  ContractUsage[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("company_profiles")
}

model CompanyFavourite {
  id              String @id @default(uuid())
  companyId       String
  company         CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Cascade)
  talentUserId    String
  talent          User @relation(fields: [talentUserId], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now())

  @@unique([companyId, talentUserId])
  @@map("company_favourites")
}

model Invitation {
  id              String   @id @default(uuid())
  recruiterId     String
  recruiter       User     @relation("InvitationRecruiter", fields: [recruiterId], references: [id], onDelete: Cascade)
  jobId           String
  job             Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  talentUserId    String
  talent          User     @relation("InvitationTalent", fields: [talentUserId], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now())

  @@unique([jobId, talentUserId])
  @@map("invitations")
}

// ================= JOBS & ROLES =================

model Job {
  id                String   @id @default(uuid())
  companyId         String
  company           CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Cascade)

  castingService    String   @default("portal") // "manual" or "portal"

 isLegacy          Boolean  @default(false)

  title             String?
  subTitle          String?
  description       String?
  service           String?

  categoryId        String?
  category          Category? @relation(fields: [categoryId], references: [id])
  subCategoryId     String?
  subCategory       SubCategory? @relation(fields: [subCategoryId], references: [id])
  projectTypeId     String?
  projectType       ProjectType? @relation(fields: [projectTypeId], references: [id])

  // Casting Location
  castingCityId     String?
  castingCity       City? @relation("CastingCity", fields: [castingCityId], references: [id])
  castingDates      String?  // JSON array of dates

  // Shooting Location
  shootingCityId    String?
  shootingCity      City? @relation("ShootingCity", fields: [shootingCityId], references: [id])
  shootingDates     String?  // JSON array of dates

  lastDateToApply   DateTime?
  usage             String?
  image             String?
  paymentInfo       String?  // "paid" or "unpaid"

  totalCastRequired Int?
  ageMin            Int?
  ageMax            Int?
  gender            String?

  status            JobStatus @default(PENDING)
  views             Int @default(0)

  roles             Role[]
  contractUsages    ContractUsage[]
  invitations       Invitation[]

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("jobs")
}

model Role {
  id                String @id @default(uuid())
  jobId             String
  job               Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  title             String?
  description       String?
  noOfCast          Int?

  ethnicity         String?
  ethnicityAll      Boolean @default(false)
  nationality       String?
  nationalityAll    Boolean @default(false)
  languageSpoken    String?  // JSON array of language IDs
  dialectsSpoken    String?  // JSON array of dialect IDs
  gender            String?
  ageMin            Int?
  ageMax            Int?
  experience        String?  // JSON array e.g. ["Amature","Professional"]
  experienceAll     Boolean @default(false)

  paymentInfo       String?
  paymentType       String?
  usage             String?

  // Location where talent can apply from
  locationCityId    String?
  locationCity      City? @relation("RoleLocationCity", fields: [locationCityId], references: [id])
  locationCountry   String?

  // Questions
  question1         String?
  question2         String?
  question3         String?

  requiredProfileVideo  Boolean @default(false)
  requiredCastingVideo  Boolean @default(false)

  payment           RolePayment?
  applications      Application[]

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("roles")
}

model RolePayment {
  id        String @id @default(uuid())
  roleId    String @unique
  role      Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  // Hourly
  hourPerDay          Int?
  hourBudgetPerHour   Int?
  hourNoOfDays        Int?
  hourCommission      Int?
  hourTalentBudget    Int?
  hourProfit          Int?

  // Daily
  dayFullDay          Int?
  dayHalfDay          Int?
  dayBudgetFullDay    Int?
  dayBudgetHalfDay    Int?
  dayTotalBudget      Int?
  dayCommission       Int?
  dayTalentFullDay    Int?
  dayTalentHalfDay    Int?
  dayTalentTotal      Int?
  dayTotalProfit      Int?

  // Weekly
  weekNoOfWeek        Int?
  weekDaysPerWeek     Int?
  weekBudgetPerWeek   Int?
  weekCommission      Int?
  weekTalentBudget    Int?
  weekProfit          Int?

  // Monthly
  monthNoOfMonth      Int?
  monthDayPerMonth    Int?
  monthBudgetPerMonth Int?
  monthCommission     Int?
  monthTalentBudget   Int?
  monthProfit         Int?

  // Package
  packageBudgetFullDay  Int?
  packageBudgetHalfDay  Int?
  packageTotalBudget    Int?
  packageCommission     Int?
  packageTotalTalent    Int?
  packageProfit         Int?

  status    Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("role_payments")
}

// ================= APPLICATIONS =================

model Application {
  id              String @id @default(uuid())
  userId          String
  user            User @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId          String
  role            Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  status          ApplicationStatus @default(APPLIED)
  formData        Json?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, roleId])
  @@map("applications")
}

// ================= CAST BAG (Enhanced) =================

model CastBag {
  id              String @id @default(uuid())
  ownerId         String
  owner           User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  name            String
  description     String?

  talents         CastBagTalent[]
  links           CastBagLink[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("cast_bags")
}

model CastBagTalent {
  id              String @id @default(uuid())
  castBagId       String
  castBag         CastBag @relation(fields: [castBagId], references: [id], onDelete: Cascade)
  talentUserId    String
  talent          User @relation("CastBagTalentOf", fields: [talentUserId], references: [id], onDelete: Cascade)

  addedAt         DateTime @default(now())

  @@unique([castBagId, talentUserId])
  @@map("cast_bag_talents")
}

model CastBagLink {
  id              String @id @default(uuid())
  castBagId       String
  castBag         CastBag @relation(fields: [castBagId], references: [id], onDelete: Cascade)

  token           String  @unique  // unique shareable URL slug
  email           String?          // who it was shared with (optional)
  status          Boolean @default(true)
  expiresAt       DateTime?

  feedback        CastBagFeedback[]
  guests          CastBagGuest[]

  createdAt       DateTime @default(now())

  @@map("cast_bag_links")
}

model CastBagGuest {
  id              String   @id @default(uuid())
  linkId          String
  link            CastBagLink @relation(fields: [linkId], references: [id], onDelete: Cascade)

  email           String
  passwordHash    String
  expiresAt       DateTime

  createdAt       DateTime @default(now())

  @@unique([linkId, email])
  @@map("cast_bag_guests")
}

model CastBagFeedback {
  id              String @id @default(uuid())
  linkId          String
  link            CastBagLink @relation(fields: [linkId], references: [id], onDelete: Cascade)

  talentUserId    String   // which talent profile the feedback is about
  talent          User @relation("CastBagFeedbackOf", fields: [talentUserId], references: [id], onDelete: Cascade)

  reviewerName    String?
  reviewerEmail   String?
  comment         String?
  rating          Int?     // optional rating
  decision        String?  // 'Preferred' | 'Reserve' | 'Pass'

  createdAt       DateTime @default(now())

  @@map("cast_bag_feedback")
}

// ================= CONTRACT / USAGE TRACKING (NEW) =================

model ContractUsage {
  id              String @id @default(uuid())
  jobId           String
  job             Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  companyId       String
  company         CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Cascade)

  talents         ContractUsageTalent[]

  projectName     String?
  contractStart   DateTime
  contractExpiry  DateTime
  usageDuration   String?

  status          ContractStatus @default(ACTIVE)
  renewalNotes    String?
  renewalHistory  RenewalHistory[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("contract_usages")
}

model ContractUsageTalent {
  id              String @id @default(uuid())
  contractUsageId String
  contractUsage   ContractUsage @relation(fields: [contractUsageId], references: [id], onDelete: Cascade)
  talentUserId    String
  talent          User @relation("ContractUsageTalentOf", fields: [talentUserId], references: [id], onDelete: Cascade)

  @@unique([contractUsageId, talentUserId])
  @@map("contract_usage_talents")
}

model RenewalHistory {
  id              String @id @default(uuid())
  contractUsageId String
  contractUsage   ContractUsage @relation(fields: [contractUsageId], references: [id], onDelete: Cascade)

  oldExpiryDate   DateTime
  newExpiryDate   DateTime
  remarks         String?

  createdAt       DateTime @default(now())

  @@map("renewal_history")
}

// ================= LOOKUP / REFERENCE TABLES =================

model Category {
  id          String @id @default(uuid())
  name        String @unique
  subCategories SubCategory[]
  jobs        Job[]
  profileAttributes ProfileAttribute[]
  talentCategories TalentCategory[]

  @@map("categories")
}

model SubCategory {
  id          String @id @default(uuid())
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  name        String
  jobs        Job[]

  @@map("sub_categories")
}

model TalentCategory {
  id              String @id @default(uuid())
  talentProfileId String
  talentProfile   TalentProfile @relation(fields: [talentProfileId], references: [id], onDelete: Cascade)
  categoryId      String
  category        Category @relation(fields: [categoryId], references: [id])

  @@unique([talentProfileId, categoryId])
  @@map("talent_categories")
}

model ProjectType {
  id    String @id @default(uuid())
  name  String @unique
  jobs  Job[]

  @@map("project_types")
}

model City {
  id        String @id @default(uuid())
  name      String
  countryId String?
  country   Country? @relation(fields: [countryId], references: [id])

  usersResidence  User[]
  talentResidence TalentProfile[]
  jobsCasting     Job[] @relation("CastingCity")
  jobsShooting    Job[] @relation("ShootingCity")
  rolesLocation   Role[] @relation("RoleLocationCity")

  @@map("cities")
}

model Country {
  id        String @id @default(uuid())
  name      String @unique
  phoneCode String @default("")
  cities    City[]

  @@map("countries")
}

model Nationality {
  id    String @id @default(uuid())
  name  String @unique
  users User[]

  @@map("nationalities")
}

model Ethnicity {
  id    String @id @default(uuid())
  name  String @unique
  talentProfiles TalentProfile[]

  @@map("ethnicities")
}

model Language {
  id    String @id @default(uuid())
  name  String @unique
  talents TalentLanguage[]

  @@map("languages")
}

model TalentLanguage {
  id              String @id @default(uuid())
  talentProfileId String
  talentProfile   TalentProfile @relation(fields: [talentProfileId], references: [id], onDelete: Cascade)
  languageId      String
  language        Language @relation(fields: [languageId], references: [id])

  @@unique([talentProfileId, languageId])
  @@map("talent_languages")
}

model Dialect {
  id    String @id @default(uuid())
  name  String @unique
  talents TalentDialect[]

  @@map("dialects")
}

model TalentDialect {
  id              String @id @default(uuid())
  talentProfileId String
  talentProfile   TalentProfile @relation(fields: [talentProfileId], references: [id], onDelete: Cascade)
  dialectId       String
  dialect         Dialect @relation(fields: [dialectId], references: [id])

  @@unique([talentProfileId, dialectId])
  @@map("talent_dialects")
}

// ================= SUBSCRIPTION PLACEHOLDER =================

model Plan {
  id              String   @id @default(uuid())
  name            String   @unique 
  slug            String   @unique 
  price           Float    @default(0)
  maxPhotos       Int      @default(8)
  maxVideos       Int      @default(3)
  maxAudios       Int      @default(1)
  maxJobsPerMonth Int      @default(1) // 999 = Unlimited
  priority        Int      @default(0) // 0 = Last, 1 = Middle, 2 = Top

  subscriptions        UserSubscription[]
  paymentTransactions  PaymentTransaction[]

  @@map("plans")
}

model UserSubscription {
  id              String             @id @default(uuid())
  userId          String             @unique // One active subscription per user
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId          String
  plan            Plan               @relation(fields: [planId], references: [id])
  status          SubscriptionStatus @default(ACTIVE)
  activatedAt     DateTime?
  expiresAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("user_subscriptions")
}

model PaymentTransaction {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId        String
  plan          Plan     @relation(fields: [planId], references: [id])
  orderId       String   @unique
  refId         String?
  amount        Float
  duration      String
  status        String   @default("COMPLETED")
  createdAt     DateTime @default(now())

  @@map("payment_transactions")
}



// ================= BLOGS =================

model Blog {
  id                    BigInt  @id @map("blog_id")
  categoryCategoryId    BigInt? @map("category_category_id")
  blogTitle             String? @map("blog_title")
  blogDescription       String? @map("blog_description")
  blogDate              String? @map("blog_date")
  blogImage             String? @map("blog_image")

  @@map("blogs")
}

model EmailTemplate {
  id          String @id @default(uuid())
  templateKey String @unique @map("template_key")
  subject     String
  body        String
  description String @default("")

  @@map("email_templates")
}

// ================= CMS / PAGE CONTENT =================

model CmsPage {
  id              String   @id @default(uuid())
  pageKey         String   @unique @map("page_key")
  metaTitle       String   @default("") @map("meta_title")
  metaDescription String   @default("") @map("meta_description")
  pageHeading     String   @default("") @map("page_heading")
  subHeading      String   @default("") @map("sub_heading")
  pageDescription String   @default("") @map("page_description")
  address         String   @default("") @map("address")
  phone           String   @default("") @map("phone")
  email           String   @default("") @map("email")
  videoUrl        String   @default("") @map("video_url")
  bottomHeading   String   @default("") @map("bottom_heading")
  bottomDescription String @default("") @map("bottom_description")
  talentFaqs      String   @default("[]") @map("talent_faqs")
  companyFaqs     String   @default("[]") @map("company_faqs")
  body            String   @default("") @map("body")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("cms_pages")
}